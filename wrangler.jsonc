{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apoy",
  "main": "worker/apoy.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apoy",
      "database_id": "df3d0bd5-04f7-4a21-b928-5256193869d3"
    }
  ]
}
